<?xml version="1.0" encoding="utf-8"?>
<!-- ic_stat_notification is referenced only by string name from Dart
     (flutter_local_notifications resolves it via Resources.getIdentifier at
     runtime), so the release resource shrinker can't see the reference and
     strips it, causing PlatformException(invalid_icon) on init. Keep it. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_notification" />
